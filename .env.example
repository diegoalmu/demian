# Copiar este archivo como .env y llenar con valores reales.
# NUNCA subir el archivo .env real a git (ver .gitignore).

# --- Proveedores de modelo ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Canal Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Gateway OpenClaw ---
OPENCLAW_GATEWAY_TOKEN=

# --- Memoria / Obsidian ---
OBSIDIAN_VAULT_PATH=/mnt/c/Users/tu_usuario/ObsidianVault

# --- GitHub (scope limitado a los repos del proyecto) ---
GITHUB_TOKEN=

# --- Infraestructura remota ---
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY_PATH=
OCI_CONFIG_PATH=

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ACCOUNT_ID=
